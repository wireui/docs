{
    "name": "wireui/docs",
    "type": "library",
    "description": "WireUi Documentation",
    "license": "MIT",
    "keywords": [
        "docs",
        "wireui",
        "livewire-ui",
        "documentation",
        "blade components",
        "laravel components",
        "livewire components"
    ],
    "authors": [
        {
            "name": "Pedro Oliveira",
            "email": "pedro@wireui.dev"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0|^13.0",
        "torchlight/torchlight-laravel": "dev-l13-compatibility"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.7|^5.3",
        "pestphp/pest-plugin-laravel": "^4.1|^5.0",
        "pestphp/pest-plugin-livewire": "^4.1|^5.0"
    },
    "autoload": {
        "psr-4": {
            "WireUi\\Docs\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "vendor/orchestra/testbench-core/laravel/app",
            "WireUi\\Docs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WireUi\\Docs\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/laravel-shift/torchlight-laravel.git"
        }
    ]
}
